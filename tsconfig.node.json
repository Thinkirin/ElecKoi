{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@eleckoi/dsh-product-data": [
        "./packages/dsh-product-data/src/index.ts"
      ],
      "@eleckoi/dsh-product-data/media": [
        "./packages/dsh-product-data/src/storage/media/index.ts"
      ],
      "@main/*": [
        "./apps/desktop/src/main/*"
      ],
      "@product-data/*": [
        "./packages/dsh-product-data/src/*"
      ],
      "@shared/*": [
        "./packages/product-shared/src/*"
      ]
    }
  },
  "include": [
    "apps/desktop/electron.vite.config.ts",
    "scripts/vite-author-vendor-plugin.ts",
    "apps/desktop/src/main/**/*.ts",
    "apps/desktop/src/preload/**/*.ts",
    "packages/product-shared/src/**/*.ts",
    "packages/dsh-product-data/src/**/*.ts",
    "packages/dsh-product-api/src/hostInspect.ts",
    "packages/dsh-product-api/src/inspectProvider.ts",
    "packages/dsh-product-api/src/cordisApi.generated.ts",
    "packages/dsh-product-api/src/client/inspect.ts",
    "packages/dsh-product-api/src/client/cordisApi.generated.ts",
    "packages/dsh-product-api/src/client/remoteApi.generated.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
